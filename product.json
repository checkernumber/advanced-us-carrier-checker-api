{
  "name": "Advanced US Carrier Checker API",
  "brand": "CheckNumber",
  "slug": "advanced-us-carrier-checker-api",
  "repository": "checkernumber/advanced-us-carrier-checker-api",
  "description": "Asynchronous file-based Advanced US Carrier Checker checks.",
  "official_site": "https://checknumber.ai",
  "landing_page": "https://checknumber.ai/products/advanced-us-carrier-checker",
  "canonical_docs": "https://docs.checknumber.ai/advanced-us-carrier-checker",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "mode": "async",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text file, one E.164 phone number per line according to task type"
  },
  "products": [
    {
      "task_type": "us_carrier_premium",
      "name": "Advanced US Carrier Checker",
      "doc_slug": "advanced-us-carrier-checker",
      "input_kind": "phone",
      "min_numbers": 2000,
      "max_numbers": 10000000,
      "result_fields": [
        "Number",
        "number_type",
        "carrier",
        "city"
      ]
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
  "maintainer": "CheckNumber",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
